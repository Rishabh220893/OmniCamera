# Copy to .env and fill in. Never commit .env.
GRID_EMAIL=
GRID_PASSWORD=
# What the app's browsers send to watch. Make it long and random (see docs/media-server.md).
MEDIA_VIEWER_PASSWORD=
# Optional
# GRID_RTSP_HOST=103.250.160.189
# GRID_RTSP_PORT=8554
# CAMERA_COUNT=30
# CAMERA_IDS=cam01,cam02
# Origin(s) of the web app that may play the video, comma separated. '*' allows any site.
# MEDIA_ALLOW_ORIGIN=https://omnicamera.onrender.com
# Public address of this machine, only needed for WebRTC from other networks.
# MEDIA_PUBLIC_HOST=
