# Gemini API Key for vision analysis
GEMINI_API_KEY=

# Firebase configuration (auto-generated but can be overridden)
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=

# Google Sheets Integration
# JSON string of service account credentials
GOOGLE_SHEETS_CREDENTIALS=
# Target Spreadsheet ID
GOOGLE_SHEETS_SPREADSHEET_ID=

# Central Registry API (Model 1 — API-based camera onboarding)
# JSON string of a Firebase service account with Firestore access.
# Leave unset to keep the registry API disabled (returns 501).
FIREBASE_SERVICE_ACCOUNT=
# Shared secret external systems must send as the X-Registry-Api-Key header.
# Leave unset only for local testing — never deploy without it.
REGISTRY_API_KEY=
